using System;
using System.Collections.Generic;
using System.ComponentModel.Design;
using System.Linq;

class Program
{
    static void Main()
    {
        Console.WriteLine("--- Vítejte u Blackjacku! ---");

        List<int> hracKarty = new List<int>();
        List<int> dealerKarty = new List<int>();
        Random rnd = new Random();

        hracKarty.Add(rnd.Next(2, 12));
        hracKarty.Add(rnd.Next(2, 12));
        dealerKarty.Add(rnd.Next(2, 12));

        Console.WriteLine("Vaše karty: " + string.Join(", ", hracKarty) + " (Součet: " + hracKarty.Sum() + ")");
        Console.WriteLine("Dealerova viditelná karta: " + dealerKarty[0]);
        if (hracKarty.Sum() > dealerKarty.Sum())
        {
            Console.WriteLine("Gratulujeme! Vyhráváte!");
        }
        else if (hracKarty.Sum() < dealerKarty.Sum())
        {
            Console.WriteLine("Bohužel, prohráváte.");
        }
        else
        {
            Console.WriteLine("Remíza!");
        }
    }
}
